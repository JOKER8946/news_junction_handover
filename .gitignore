# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Environment and sensitive variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs and runtime databases
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS and Editor generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE and Editor configs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
