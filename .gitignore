*.swo

# Temporary directories
tmp/
temp/
scratch/
.system_generated/

# Large user-uploaded media directories (avoids hitting GitHub 2GB push limit)
app/data/covers/*
!app/data/covers/.gitkeep
app/uploads/*
!app/uploads/.gitkeep
app/manikya_market/uploads/*
!app/manikya_market/uploads/.gitkeep
