# PostgreSQL: local defaults match compose.yaml. Use a private connection string in production.
DATABASE_URL=postgresql://newsjunction:newsjunction@127.0.0.1:5432/newsjunction
PORT=3000
NODE_ENV=development
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters-before-deployment
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=0
# Optional demo seed. Do not use the live website password for a sample account.
SEED_ADMIN_EMAIL=editor@newsjunction.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-local-password
# Docker database password. Match the DATABASE_URL above.
POSTGRES_PASSWORD=newsjunction
POSTGRES_DB=newsjunction
