# ==============================================================================
# News Junction - Environment Configuration Template
# Duplicate this file to .env and configure your environment variables.
# ==============================================================================

# Server Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MySQL Database Configuration
# (If MySQL is unreachable, the system gracefully falls back to the in-memory engine)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=nj_cream

# Session Secret Key
SESSION_SECRET=news-junction-session-secret-2026
